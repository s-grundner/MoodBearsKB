#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>        
#include <locale/keys_de.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define ADJ  4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&caps_word {
    continue-list = <UNDERSCORE MINUS>;
};

/ {
    keymap {
        compatible = "zmk,keymap";
        base_layer {
            label= "BASE";
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     E     ┃     R     ┃     T     ┃   ┃     Z     ┃     U     ┃     I     ┃     O     ┃     P     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃    ESC    ┃     A     ┃     S     ┃     D     ┃     F     ┃     G     ┃   ┃     H     ┃     J     ┃     K     ┃     L     ┃     Ö     ┃   BSPC    ┃ 
            // ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            // ┃    TAB    ┃     Y     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     N     ┃     M     ┃     ,     ┃     .     ┃     -     ┃    DEL    ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃   SUPER   ┃    NUM    ┃   SPACE   ┃   ┃   SPACE   ┃    SYM    ┃   ENTER   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            bindings = <
                &kp DE_Q     &kp DE_W  &kp DE_E       &kp DE_R        &kp DE_T         &kp DE_Z   &kp DE_U  &kp DE_I         &kp DE_O        &kp DE_P
                &lt NAV ESC  &kp DE_A  &mt LALT DE_S  &mt LCTRL DE_D  &mt LSHIFT DE_F  &kp DE_G   &kp DE_H  &mt RSHIFT DE_J  &mt RCTRL DE_K  &mt RALT DE_L  &kp DE_O_UMLAUT  &kp BSPC
                &kp TAB      &kp DE_Y  &kp DE_X       &kp DE_C        &kp DE_V         &kp DE_B   &kp DE_N  &kp DE_M         &kp DE_COMMA    &kp DE_DOT     &kp DE_MINUS  &kp DEL
                &kp LGUI     &mo NUM   &kp SPACE      &kp SPACE       &mo SYM          &lt NAV ENTER
            >;
        };

        nav_layer {
            label= "NAV";
            bindings = <
                &trans  &trans  &trans    &trans     &trans      &trans      &trans    &trans     &trans     &trans
                &trans  &trans  &kp LALT  &kp LCTRL  &kp LSHIFT  &trans      &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans  
                &trans  &trans  &trans    &trans     &trans      &caps_word  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &trans  
                &trans  &trans  &trans    &trans     &trans      &trans
            >;
        };

        num_layer {
            label= "NUM";
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     ´     ┃     `     ┃     <     ┃     >     ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃    ESC    ┃   SUPER   ┃    ALT    ┃   CTRL    ┃   SHIFT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     *     ┃   BSPC    ┃
            // ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            // ┃    TAB    ┃           ┃     ~     ┃     /     ┃     \     ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     -     ┃   ENTER   ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃   SUPER   ┃███████████┃   SPACE   ┃   ┃   SPACE   ┃    ADJ    ┃     0     ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            bindings = <
                &kp DE_GRAVE  &kp DE_ACUTE  &kp DE_LT     &kp DE_GT    &kp DE_LBRC  &kp DE_RBRC  &kp N7       &kp N8  &kp N9  &kp DE_PLUS
                &trans        &kp LGUI      &kp LALT      &kp LCTRL    &kp LSHIFT   &kp DE_LBKT  &kp DE_RBKT  &kp N4  &kp N5  &kp N6  &kp DE_STAR &trans
                &trans        &trans        &kp DE_TILDE  &kp DE_FSLH  &kp DE_BSLH  &kp DE_LPAR  &kp DE_RPAR  &kp N1  &kp N2  &kp N3  &kp DE_MINUS &trans      
                &trans        &trans        &trans        &trans       &mo ADJ      &kp N0 
            >;
        };

        sym_layer {
            label= "SYM";
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     !     ┃     "     ┃     '     ┃     $     ┃     %     ┃   ┃     &     ┃     #     ┃     =     ┃     ?     ┃     Ü     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃    ESC    ┃     @     ┃     €     ┃     |     ┃     ^     ┃     °     ┃   ┃   PREV    ┃   PAUSE   ┃   NEXT    ┃     ~     ┃     Ä     ┃   BSPC    ┃
            // ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            // ┃    TAB    ┃  EMAIL1   ┃  EMAIL2   ┃           ┃           ┃           ┃   ┃   VOL-    ┃   MUTE    ┃   VOL+    ┃     µ     ┃     ß     ┃    DEL    ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    GIF    ┃    ADJ    ┃   SPACE   ┃   ┃   SPACE   ┃███████████┃   ENTER   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            bindings = <
                &kp DE_EXCL  &kp DE_DQT  &kp DE_SQT   &kp DE_DLLR  &kp DE_PRCNT  &kp DE_AMPS   &kp DE_HASH   &kp DE_EQUAL  &kp DE_QMARK  &kp DE_U_UMLAUT
                &trans       &kp DE_AT   &kp DE_EURO  &kp DE_PIPE  &kp DE_CARET  &kp DE_DEG    &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp DE_TILDE     &kp DE_A_UMLAUT  &trans
                &trans       &trans      &trans    &trans    &trans     &trans   &kp C_VOL_DN  &kp C_MUTE    &kp C_VOL_UP  &trans        &kp DE_SZ        &trans         
                &kp LG(DOT)  &mo ADJ     &trans    &trans    &trans     &trans
            >;
        };

        adjust_layer {
            label= "ADJ";
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃           ┃           ┃           ┃   ┃           ┃    F7     ┃    F8     ┃    F9     ┃    F12    ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃   RESET   ┃           ┃    ALT    ┃    CTRL   ┃   SHIFT   ┃           ┃   ┃           ┃    F4     ┃    F5     ┃    F6     ┃    F11    ┃   BSPC    ┃
            // ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            // ┃  BOOTLOAD ┃  OUT TOG  ┃  BT PREV  ┃  BT CLEAR ┃  BT NEXT  ┃           ┃   ┃           ┃    F1     ┃    F2     ┃    F3     ┃    F10    ┃    DEL    ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃███████████┃           ┃   ┃           ┃███████████┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            bindings = <
                &trans      &trans        &trans      &trans      &trans      &trans  &kp F7  &kp F8  &kp F9  &kp F12
                &sys_reset  &trans        &kp LALT    &kp LCTRL   &kp LSHIFT  &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
                &bootloader &out OUT_TOG  &bt BT_PRV  &bt BT_CLR  &bt BT_NXT  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans         
                &trans      &trans        &trans      &trans      &trans      &trans      
            >;
        };
    };
};
